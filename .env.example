# ── Data-Analysis-Agent (custom build) environment ──────────────────────────
# Copy to `.env` and fill in. Used by docker-compose (`env_file`). NEVER commit
# the real `.env`.

# Server port inside the container (compose maps host 5001 → this).
AGENT_PORT=5001

# Config persistence dirs (already set in the image; override only if you
# remap the volume mount points).
LLM_CONFIG_DIR=/app/persist/llm
DATASOURCE_CONFIG_DIR=/app/persist/data

# ── LLM API keys (optional) ──────────────────────────────────────────────────
# Keys are normally entered in the UI (model settings) and persisted to the
# volume. These env vars are only read if you start the manager with env
# back-loading enabled; the UI is the recommended path for multi-account.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ── Data source / Lark credentials ───────────────────────────────────────────
# These are entered in the UI connect dialogs and persisted to the volume;
# listed here only as documentation of what each connector needs:
#   MaxCompute/DataWorks : AccessKey ID + Secret, Project, Endpoint
#   SelectDB             : Host, Port (9030), User, Password, Database
#   OSS                  : Endpoint, Bucket, Object key, AccessKey ID + Secret
#   Lark (sheets + docs) : configured via an MCP server in "MCP 设置"
